+extern "C"
+JNIEXPORT jint JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_loadAtOffset(
+        JNIEnv *, jobject, jint asset_fd, jlong offset, jlong length) {
+    // This descriptor points to an uncompressed asset in the installed, signed APK.
+    const int fd = dup(asset_fd);
+    if (fd < 0) {
+        return 1;
+    }
+    FILE * opened = fdopen(fd, "rb");
+    if (!opened) {
+        close(fd);
+        return 1;
+    }
+    const std::unique_ptr<FILE, decltype(&fclose)> file(opened, &fclose);
+    struct stat info{};
+    if (offset < 0 || length <= 24 || offset % 32 != 0 ||
+        fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) ||
+        offset > info.st_size || length > info.st_size - offset ||
+        fseeko(file.get(), static_cast<off_t>(offset), SEEK_SET) != 0) {
+        return 1;
+    }
+
+    auto params = llama_model_default_params();
+    params.load_mode = LLAMA_LOAD_MODE_MMAP;
+    auto *model = llama_model_load_from_file_ptr(file.get(), params);
+    if (!model) {
+        return 1;
+    }
+    g_model = model;
+    LOGi("Mapped bundled model directly from APK");
+    return 0;
+}
